# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info

# ── HTTP (health only; not exposed publicly) ──
HTTP_HOST=0.0.0.0
HTTP_PORT=8084

# ── MongoDB (Mongoose) ──
# `notification` DB on the `rs0` replica set. Match infra/.env credentials. The
# compose network form is:
#   mongodb://<user>:<pass>@mongo:27017/notification?authSource=admin&replicaSet=rs0
# Indexes (incl. the unique eventId inbox index) are built by `npm run
# sync-indexes`, which the Docker entrypoint runs before every start.
MONGO_URI=mongodb://notification_svc:changeme@localhost:27017/notification?authSource=admin&replicaSet=rs0

# ── Kafka (consumer only — this service never publishes) ──
# Consumes user.registered, order.confirmed, order.cancelled, order.shipped,
# order.delivered. A failing handler is retried with exponential backoff; after
# MAX_RETRIES it is logged as a poison message and its offset committed.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_CONSUMER_GROUP_ID=notification-service
KAFKA_CONSUMER_MAX_RETRIES=5
KAFKA_CONSUMER_RETRY_BASE_MS=1000
KAFKA_CONSUMER_RETRY_MAX_MS=30000

# ── user-service gRPC (GetUser → recipient email) ──
USER_SERVICE_URL=localhost:5001

# ── SMTP (Mailpit in dev: UI on http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@ecom.local

# ── Retry job (NTF-7) ──
# Every INTERVAL_MS, re-sends FAILED notifications until they reach
# MAX_ATTEMPTS in total (the first send counts as 1). After the n-th failure a
# row waits BASE_DELAY_MS * 2^(n-1) (capped at 1 h) before the next try. Also
# recovers PENDING rows untouched for PENDING_STALE_MS (crash between insert
# and send).
NOTIFICATION_RETRY_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_INTERVAL_MS=60000
NOTIFICATION_RETRY_BASE_DELAY_MS=60000
NOTIFICATION_PENDING_STALE_MS=300000
